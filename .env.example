# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required. Signs session cookies and encrypts the secrets kept in the database (GitHub
# token, TOTP secret, notification URLs). Changing it signs everyone out and those must be
# entered again (two-factor: mfa_admin.py reset). Generate with: openssl rand -hex 32
SECRET_KEY=

# Required. Login credentials for the web UI — this app has a single operator account.
APP_USERNAME=admin
APP_PASSWORD=

# Comma-separated hostnames this app is allowed to be reached as (blocks DNS-rebinding
# attacks). Add your Tailscale/LAN hostname if you access it as anything other than
# localhost.
ALLOWED_HOSTS=localhost,127.0.0.1

# Exact origin (scheme://host[:port]) browsers are allowed to submit forms from, as a
# second CSRF check on top of the token. Leave blank to accept only the scheme and host
# the request itself arrived on. Set it when a TLS reverse proxy sits in front (the app
# then sees http:// while the browser sends https://), e.g. https://adb.home.lan
ALLOWED_ORIGIN=

# Browsers only send Secure cookies over HTTPS (or to localhost), so sign-in over plain
# http://<LAN-IP>:8080 needs this set to false. Leave true behind a TLS reverse proxy —
# over plain HTTP the session cookie travels in cleartext.
COOKIE_SECURE=true

# Optional. Fine-grained GitHub PAT with read-only access, scoped to just the repos
# you're watching: Contents: read for releases, plus Actions: read to stage workflow
# artifacts (GitHub only serves those to an authenticated caller). Leave blank to poll
# public repos unauthenticated (60 req/hr per IP — fine for a handful of repos on a
# 10 minute interval). A token saved under Settings → Artifacts takes precedence.
GITHUB_TOKEN=

POLL_INTERVAL_MINUTES=10

# Optional. Notifications via Apprise — one or more service URLs, separated by
# spaces or commas. Examples: ntfy://ntfy.sh/my-topic, gotifys://host/TOKEN,
# hassios://homeassistant.local/ACCESS_TOKEN, json://host/path (a plain JSON
# POST). Full list: https://github.com/caronc/apprise/wiki. These URLs contain
# credentials: keep them here only.
APPRISE_URLS=

# Which events to send (comma-separated). Blank = all of:
# staged, rejected, install_success, install_failed
NOTIFY_EVENTS=

# How many staged releases to keep on disk per repo. Older files are deleted
# after each new release is staged; their install history is kept.
KEEP_RELEASES_PER_REPO=3

DB_PATH=/data/app.db
STAGING_ROOT=/data/staging

# Port range scanned on a paired device's last known IP when its wireless
# debugging port has changed. Only private IPs of already-paired devices are
# ever scanned.
ADB_SCAN_PORTS=30000-49999

ADB_HOST=adb-server
ADB_PORT=5037
