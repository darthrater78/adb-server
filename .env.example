# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required. Signs session cookies. Generate with: openssl rand -hex 32
SECRET_KEY=

# Required. Login credentials for the web UI — this app has a single operator account.
APP_USERNAME=admin
APP_PASSWORD=

# Comma-separated hostnames this app is allowed to be reached as (blocks DNS-rebinding
# attacks). Add your Tailscale/LAN hostname if you access it as anything other than
# localhost.
ALLOWED_HOSTS=localhost,127.0.0.1

# Exact origin (scheme://host[:port]) browsers are allowed to submit forms from, as a
# second CSRF check on top of the token. Leave blank to only allow same-origin requests
# with no Origin header (plain browser form posts).
ALLOWED_ORIGIN=

# Set to false only if you are deliberately serving over plain HTTP (e.g. localhost-only
# testing). Leave true behind any real deployment — session cookies otherwise leak in
# cleartext.
COOKIE_SECURE=true

# Optional. Fine-grained GitHub PAT with read-only Contents access, scoped to just the
# repos you're watching. Leave blank to poll public repos unauthenticated (60 req/hr
# per IP — fine for a handful of repos on a 10 minute interval).
GITHUB_TOKEN=

POLL_INTERVAL_MINUTES=10

DB_PATH=/data/app.db
STAGING_ROOT=/data/staging

ADB_HOST=adb-server
ADB_PORT=5037
